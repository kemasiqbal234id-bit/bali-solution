# Salin file ini menjadi .env lalu isi.
PORT=3000
# Password awal dashboard admin (bisa diganti dari dashboard: menu Pengaturan > Keamanan).
# Kosongkan = dibuatkan password acak saat pertama kali jalan (tampil di terminal).
ADMIN_PASSWORD=
# Isi true bila situs dilayani lewat HTTPS (disarankan di server produksi).
COOKIE_SECURE=false
# Opsional: folder data (konten + foto). Arahkan ke volume persisten bila hosting Anda mereset disk.
# DATA_DIR=/var/data/bsb
# Alamat publik situs, untuk meta OpenGraph. Contoh: https://balisolutionbuilding.com
SITE_URL=
